# Database (compose.yml service "db")
DATABASE_URL="mysql://root:droolbites_root@localhost:3306/droolbites"

# Session signing key — any long random string (openssl rand -base64 32)
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true

# Rate limiting trusts X-Real-IP / X-Forwarded-For only with TRUST_PROXY=1, i.e. behind one
# reverse proxy that sets them. Leave it unset when clients reach the app directly.
# TRUST_PROXY=1

# Public site URL (used in emails and payment callbacks)
APP_URL="http://localhost:3000"

# Email (local Mailpit; inbox at http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT=1025
MAIL_FROM="Droolbites <hello@droolbites.biz.id>"

# "Continue with Google" (customers only). Leave both empty to hide the button.
# Setup: Google Cloud Console > APIs & Services > OAuth consent screen (External; scopes openid,
# email, profile), then Credentials > Create credentials > OAuth client ID > Web application.
# Authorized redirect URIs = <APP_URL>/auth/google/callback, i.e. http://localhost:3000/auth/google/callback
# (npm run dev) and http://localhost:8080/auth/google/callback (Docker app). Paste the client ID and secret here.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Payment provider: mock (no real money) | belibayar
PAYMENT_PROVIDER="mock"

# Demo payments: "on" adds a secondary PAY INSTANTLY button under PAY on /checkout/payment. No money
# moves: the order is placed paid without the gateway and then behaves exactly like any paid order
# (emails, stock, status steps; the admin shows it as an ordinary paid order). Anything else (or empty) = off.
DEMO_PAYMENTS=""

# Checkout follows the store's opening hours (admin › Settings, WIB): outside them, and from 30 minutes
# before closing, nothing can be ordered. "on" keeps checkout open around the clock, for testing only;
# never on the live store. Anything else (or empty) = follow the hours.
STORE_HOURS_ALWAYS_OPEN=""

# Belibayar Direct API (https://docs.belibayar.id/docs). Keys and secrets come from the
# Belibayar dashboard › Kredensial. A byr_test_ key uses the sandbox, byr_live_ charges real money.
# The webhook secret verifies POST /api/payments/belibayar/webhook (APP_URL must be https).
BELIBAYAR_BASE_URL="https://api.belibayar.id"
BELIBAYAR_API_KEY=""
BELIBAYAR_SECRET_KEY=""
BELIBAYAR_WEBHOOK_SECRET=""
