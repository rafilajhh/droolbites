# Database (compose.yml service "db")
DATABASE_URL="mysql://root:droolbites_root@localhost:3306/droolbites"

# Session signing key — any long random string (openssl rand -base64 32)
AUTH_SECRET="change-me"
AUTH_TRUST_HOST=true

# Rate limiting trusts X-Real-IP / X-Forwarded-For only with TRUST_PROXY=1, i.e. behind one
# reverse proxy that sets them. Leave it unset when clients reach the app directly.
# TRUST_PROXY=1

# Public site URL (used in emails and payment callbacks)
APP_URL="http://localhost:3000"

# Email (local Mailpit; inbox at http://localhost:8025)
SMTP_HOST="localhost"
SMTP_PORT=1025
MAIL_FROM="Droolbites <hello@droolbites.biz.id>"

# Payment provider: mock (no real money) | belibayar
PAYMENT_PROVIDER="mock"

# Belibayar Direct API (https://docs.belibayar.id/docs). Keys and secrets come from the
# Belibayar dashboard › Kredensial. A byr_test_ key uses the sandbox, byr_live_ charges real money.
# The webhook secret verifies POST /api/payments/belibayar/webhook (APP_URL must be https).
BELIBAYAR_BASE_URL="https://api.belibayar.id"
BELIBAYAR_API_KEY=""
BELIBAYAR_SECRET_KEY=""
BELIBAYAR_WEBHOOK_SECRET=""
