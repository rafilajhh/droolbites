# Production settings for the VPS. Copy to .env on the server (never commit .env):
#   cp .env.production.example .env && nano .env
# Used by: docker compose -f compose.yml -f compose.prod.yml up -d --build
# Generate every secret with openssl (hex keeps it URL-safe); avoid "$" in any value.

# Public site URL (nginx serves it, deploy/nginx/droolbites.conf). Must be https: session
# cookies are Secure and Belibayar only sends webhooks to https.
APP_URL="https://droolbites.biz.id"

# Session signing key: openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST=true

# MySQL passwords, only applied when the database volume is first created
# (changing them later does not change the database). openssl rand -hex 24
MYSQL_ROOT_PASSWORD=""
MYSQL_PASSWORD=""

# Admin account for the production seed (prisma/seed-production.ts) ONLY.
# Prefer passing them with `run -e` (docs/deploy-vps.md); if you put them here, clear them after seeding.
# Password: at least 12 characters. ADMIN_RESET_PASSWORD=1 replaces an existing admin's password.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_RESET_PASSWORD=""

# Email. Empty SMTP_HOST = email off (orders, payments and resets still work; no emails are sent).
# Later: your mail provider's SMTP server, port 587 (STARTTLS).
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Droolbites <hello@droolbites.biz.id>"

# "Continue with Google" (customers only). Empty hides the button.
# Authorized redirect URI in Google Cloud Console: https://droolbites.biz.id/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Payments: mock (no real money) | belibayar
PAYMENT_PROVIDER="mock"

# Belibayar (dashboard › Kredensial). byr_test_ = sandbox, byr_live_ = real money.
# Webhook URL to set in the Belibayar dashboard: https://droolbites.biz.id/api/payments/belibayar/webhook
# The VPS public IP must be on the Belibayar IP whitelist.
BELIBAYAR_BASE_URL="https://api.belibayar.id"
BELIBAYAR_API_KEY=""
BELIBAYAR_SECRET_KEY=""
BELIBAYAR_WEBHOOK_SECRET=""
